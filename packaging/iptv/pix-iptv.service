[Unit]
Description=PIX terrestrial IPTV and programme guide
Requires=docker.service pixd.service
After=network-online.target docker.service pixd.service
Wants=network-online.target
PartOf=pixd.service
Conflicts=pix-live.service

[Service]
Type=simple
WorkingDirectory=/opt/pix-iptv
ExecStart=/usr/bin/docker-compose up --no-color --abort-on-container-exit
ExecStop=/usr/bin/docker-compose down --timeout 20
Restart=always
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
